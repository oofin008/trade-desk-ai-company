# Copy to .env and fill in. .env is gitignored.

# ── GitHub ────────────────────────────────────────────────────────────────
# PAT with repo + issues + workflow scopes (used by the GitHub MCP and gh CLI).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx

# ── Discord: multi-agent system (scripts/discord-agents) ──────────────────
# One bot application + token per agent. Names match roster.json -> tokenEnv.
# See scripts/discord-agents/README.md for how to create the bot apps.
DISCORD_TOKEN_CEO=
DISCORD_TOKEN_PRODUCT=
DISCORD_TOKEN_SOFTWARE=
DISCORD_TOKEN_MARKETING=
DISCORD_TOKEN_SALES=

DISCORD_CHANNEL_ID=            # the one shared channel all bots join
ALLOWED_USER_IDS=             # your Discord user id(s), comma-separated — required in practice
AI_STARTUP_DIR=/abs/path/to/ai-company-template   # absolute path to this repo

# ── Cost / safety knobs (optional; defaults shown) ────────────────────────
HOP_BUDGET=6                  # max agent->agent hops per founder message
MAX_CONCURRENCY=2             # max simultaneous claude invocations across all agents
CLAUDE_TIMEOUT_MINUTES=30
SESSION_USD_LIMIT=5           # ledger auto-freezes at this session spend
DAILY_USD_LIMIT=20           # ...and this daily spend
AGENT_MEMORY=session          # session = agents remember prior turns; off = stateless (cheapest)
LOG_AGENT_STEPS=0            # 1 = stream each turn's thinking + tool steps

# ── Discord: legacy single-driver bridge (scripts/discord-bridge) ─────────
# Only needed if you use the fallback bridge instead of the multi-agent system.
DISCORD_TOKEN=
